#!/usr/bin/make -f

# Append -kilv to kernel version so uname -r identifies our build
# kernel-snippet.mk passes KERNELRELEASE to make which overrides
# CONFIG_LOCALVERSION, so we must set it here before the include.
override KERNEL_BASE_VERSION = 4.14-336-kilv
export KBUILD_BUILD_USER = kilv

# Override init_boot target BEFORE include so it matches first
# Reference: https://github.com/droidian/linux-packaging-snippets/blob/droidian/kernel-snippet.mk#L357
out/KERNEL_OBJ/init_boot-%.img: out/KERNEL_OBJ/initramfs.% out/KERNEL_OBJ/dtb-merged
	eval mkbootimg \
		--header_version $(KERNEL_BOOTIMAGE_VERSION) \
		--ramdisk $< \
		--dtb $(KERNEL_OUT)/dtb-merged \
		--dtb_offset $(KERNEL_BOOTIMAGE_DTB_OFFSET) \
		--pagesize $(KERNEL_BOOTIMAGE_PAGE_SIZE) \
		-o $@

include /usr/share/linux-packaging-snippets/kernel-snippet.mk

# Patch bootimage postinst to suppress depmod warning about missing modules.builtin.modinfo
override_dh_auto_install: patch_bootimage_postinst

patch_bootimage_postinst:
	sed -i 's|depmod -a|touch /lib/modules/$(KERNEL_RELEASE)/modules.builtin.modinfo 2>/dev/null; depmod -a|' \
		debian/linux-bootimage-$(KERNEL_RELEASE).postinst

%:
	dh $@
